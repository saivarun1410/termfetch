Output marketing/.termfetch-terminal.mp4

Set Shell "zsh"
Set FontFamily "Menlo"
Set FontSize 26
Set LetterSpacing 0
Set LineHeight 1.2
Set Width 1440
Set Height 810
Set Padding 42
Set Margin 24
Set MarginFill "#05070b"
Set BorderRadius 16
Set WindowBar "ColorfulRight"
Set WindowBarSize 42
Set Theme {"background":"#0d1117","foreground":"#f0f6fc","cursor":"#79c0ff","black":"#484f58","red":"#ff7b72","green":"#3fb950","yellow":"#d29922","blue":"#58a6ff","magenta":"#bc8cff","cyan":"#39c5cf","white":"#b1bac4","brightBlack":"#6e7681","brightRed":"#ffa198","brightGreen":"#56d364","brightYellow":"#e3b341","brightBlue":"#79c0ff","brightMagenta":"#d2a8ff","brightCyan":"#56d4dd","brightWhite":"#f0f6fc"}
Set TypingSpeed 24ms
Set Framerate 30

Hide
Type "export PS1='❯ '; clear" Enter
Show
Sleep 700ms
Type "pipx install termfetch" Enter
Sleep 900ms
Type "termfetch init --user saivarun1410 --image photo.jpg --theme dracula" Enter
Sleep 900ms
Type "termfetch" Enter
Sleep 1400ms

# The final product card is rendered from demo-config.json. It deliberately uses
# the colored ASCII renderer so the portrait reads as neofetch-style terminal art
# in both the MP4 and the smaller README GIF.
